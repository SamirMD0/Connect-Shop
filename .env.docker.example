# Copy this file to .env.docker and replace placeholders before running Docker Compose.
# Do not commit real secrets.

# ─── Ports ───────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=5000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=elecshop
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=elecshop_db
DATABASE_URL=postgresql://elecshop:replace_with_a_strong_local_password@postgres:5432/elecshop_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Backend Security ────────────────────────────────────────────────────────
# Local Docker defaults to development so optional production services like
# ImageKit do not block startup. For staging/production-like testing, set this
# to production and provide all required production env vars.
BACKEND_NODE_ENV=development
LOG_PRETTY=false
SESSION_SECRET=replace_with_at_least_32_random_characters_for_docker
COOKIE_SECRET=replace_with_cookie_secret_if_you_add_separate_cookie_config
CSRF_SECRET=replace_with_csrf_secret_if_you_add_separate_csrf_config
COOKIE_MAX_AGE=604800000

# ─── OAuth Placeholders Required By Backend Env Validation ───────────────────
GOOGLE_CLIENT_ID=docker_local_placeholder
GOOGLE_CLIENT_SECRET=docker_local_placeholder
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── CORS / URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Browser-reachable API URL. Do not set this to http://backend:5000.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side frontend API URL inside the Docker network.
INTERNAL_API_URL=http://backend:5000

# ─── Public Business Copy ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ELECTRO SHOP
NEXT_PUBLIC_BUSINESS_PHONE=+961 00 000 000
NEXT_PUBLIC_BUSINESS_WHATSAPP=+96100000000
NEXT_PUBLIC_BUSINESS_EMAIL=support@example.com
NEXT_PUBLIC_BUSINESS_ADDRESS=Lebanon
NEXT_PUBLIC_BUSINESS_HOURS=Monday to Saturday, 9:00 AM - 8:00 PM

# ─── Optional Sentry ─────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=docker-local
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=

# ─── Optional ImageKit Uploads ───────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/connect-shop
