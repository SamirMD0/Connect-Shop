# Frontend API target
# Local: http://localhost:5000
# Production: https://your-render-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public site URL used for SEO metadata, sitemap, canonical URLs, and sharing.
# Local: http://localhost:3000
# Production: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store branding and contact details. Replace before client handover.
NEXT_PUBLIC_APP_NAME=ELECTRO SHOP
NEXT_PUBLIC_BUSINESS_PHONE="+961 00 000 000"
NEXT_PUBLIC_BUSINESS_WHATSAPP="+96100000000"
NEXT_PUBLIC_BUSINESS_EMAIL=support@example.com
NEXT_PUBLIC_BUSINESS_ADDRESS=Lebanon
NEXT_PUBLIC_BUSINESS_HOURS="Monday to Saturday, 9:00 AM - 8:00 PM"

# Optional Sentry browser/server error reporting.
# Leave blank locally and in CI unless you want errors reported to Sentry.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Optional source map upload settings for production builds.
# Never commit a real auth token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
