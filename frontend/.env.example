# Frontend API target
# Local: http://localhost:5000
# Production: https://your-render-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public catalog GET/HEAD deadline including response parsing (default 5000, capped 30000).
# This is a build-time browser setting. Auth, writes, checkout and orders are excluded.
NEXT_PUBLIC_STOREFRONT_READ_TIMEOUT_MS=5000

# Server-side API target for Next.js SSR.
# Local Docker/self-hosted example: http://backend:5000
# Vercel/Render production example: https://api.your-domain.com
INTERNAL_API_URL=http://localhost:5000

# Server-only shared secret for trusted SSR public reads.
# Must match backend INTERNAL_SSR_API_SECRET.
# Never rename this to NEXT_PUBLIC_*.
INTERNAL_SSR_API_SECRET=

# Public site URL used for SEO metadata, sitemap, canonical URLs, and sharing.
# Local: http://localhost:3000
# Production: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store branding and contact details. Replace before client handover.
NEXT_PUBLIC_APP_NAME=ELECTRO SHOP
NEXT_PUBLIC_BUSINESS_PHONE="+961 00 000 000"
NEXT_PUBLIC_BUSINESS_WHATSAPP="+96100000000"
NEXT_PUBLIC_BUSINESS_EMAIL=support@example.com
NEXT_PUBLIC_BUSINESS_ADDRESS=Lebanon
NEXT_PUBLIC_BUSINESS_HOURS="Monday to Saturday, 9:00 AM - 8:00 PM"

# Public ImageKit URL endpoint for optimized public image URLs when needed.
# Example placeholder: https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Optional Sentry browser/server error reporting.
# Leave blank locally and in CI unless you want errors reported to Sentry.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Optional source map upload settings for production builds.
# Never commit a real auth token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional server-side performance logging.
# When enabled, homepage aggregate timings include success/failure and body parsing,
# even below slow thresholds. No URL origin, headers, response data, or errors are logged.
PERF_LOGGING_ENABLED=false
PERF_SLOW_REQUEST_MS=1000
PERF_SLOW_FETCH_MS=
PERF_SLOW_RENDER_MS=

# Branding/metadata colors are public BUILD-TIME settings. Currency/tax/shipping
# come from /api/v1/store/config and checkout quotes; do not duplicate them here.
NEXT_PUBLIC_META_TITLE="ELECTRO SHOP — Premium Electronics Store"
NEXT_PUBLIC_META_DESCRIPTION="Shop electronics and accessories with cash on delivery."
NEXT_PUBLIC_META_KEYWORDS="electronics,cash on delivery,ELECTRO SHOP"
NEXT_PUBLIC_COLOR_ACCENT="#2563eb"
NEXT_PUBLIC_COLOR_ACCENT_HOVER="#1d4ed8"
NEXT_PUBLIC_COLOR_ACCENT_GLOW="#60a5fa"
NEXT_PUBLIC_COLOR_BACKGROUND="#f8fafc"
NEXT_PUBLIC_COLOR_SURFACE="#ffffff"
NEXT_PUBLIC_COLOR_ELEVATED="#f1f5f9"
NEXT_PUBLIC_COLOR_TEXT="#0f172a"
NEXT_PUBLIC_COLOR_MUTED="#64748b"
NEXT_PUBLIC_COLOR_BORDER="#e2e8f0"
