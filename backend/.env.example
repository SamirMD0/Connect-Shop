# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_PRETTY=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string used by the running application.
# On a hosted provider such as Neon, use the POOLED connection string here.
# Prefer `?sslmode=verify-full` over `sslmode=require`: both verify the certificate
# with the current driver, but `require` is slated to adopt weaker libpq semantics in
# pg v9. `channel_binding=require` is harmless to keep but has no effect on its own —
# pg-connection-string does not read it. The driver negotiates SCRAM-SHA-256-PLUS
# because config/db.ts sets `enableChannelBinding` whenever the URL requests TLS.
#   Neon pooled: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require
DATABASE_URL=postgresql://elecshop:elecshop_password@localhost:5432/elecshop_db

# Optional DIRECT (non-pooled) connection string, used only by `npm run migrate:prod`.
# Migrations need session-scoped advisory locks and long-running DDL, which are not
# reliable through a transaction-mode connection pooler. Falls back to DATABASE_URL.
#   Neon direct: postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require
DIRECT_DATABASE_URL=

# Query time limit in milliseconds. Set to 0 to disable.
# Enforced as a per-query client-side deadline everywhere, plus real server-side
# cancellation via `SET LOCAL statement_timeout` in transactions and, on non-pooled
# endpoints, the `statement_timeout` connection parameter. A transaction-mode pooler
# rejects that connection parameter, which is why it is skipped for `-pooler.` hosts.
DB_STATEMENT_TIMEOUT_MS=10000

# Local development convenience: applies schema.sql + seed.sql at server startup.
# Leave false in production and use `npm run migrate:prod` instead, which runs the
# schema and then the migrations in the correct order before the server starts.
INITIALIZE_DATABASE=false

# ─── Database Backups ─────────────────────────────────────────────────────────
# Used by scripts/backup_db.sh. Leave BACKUP_DIR blank to use
# <project-root>/backups/database, or set an absolute server path.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7

# ─── Session ──────────────────────────────────────────────────────────────────
# A long, cryptographically random string used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_64_chars_long

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback (dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin that is allowed to send credentialed requests
FRONTEND_URL=http://localhost:3000

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional in local development. If omitted, the backend falls back to
# in-memory rate limiting and disables Redis-backed caching.
# Empty/whitespace-only values are also omitted; malformed nonempty URLs fail validation.
# REDIS_URL=redis://localhost:6379
# Production/staging should use a paid/higher-capacity managed Redis URL.
REDIS_URL=
# Maximum wait per public cache operation; rate-limit/invalidation policy is unchanged.
REDIS_CACHE_TIMEOUT_MS=250
# Optional aggregate/CMS section deadline; individual CMS blocks use half this budget.
HOMEPAGE_OPTIONAL_TIMEOUT_MS=1200

# ─── Public Read Rate Limits ──────────────────────────────────────────────────
# Leave blank to use environment-aware defaults.
PUBLIC_READ_WINDOW_MS=900000
PUBLIC_READ_HOMEPAGE_LIMIT=
PUBLIC_READ_PRODUCT_LIST_LIMIT=
PUBLIC_READ_PRODUCT_DETAIL_LIMIT=
PUBLIC_READ_METADATA_LIMIT=
PUBLIC_READ_FALLBACK_LIMIT=
PUBLIC_READ_SSR_LIMIT=

# Server-only shared secret for trusted Next.js SSR public reads.
# Set the same value in backend and frontend. Never prefix this with NEXT_PUBLIC.
INTERNAL_SSR_API_SECRET=

# ─── Sentry Error Tracking ────────────────────────────────────────────────────
# Optional. Leave SENTRY_DSN blank in local development and CI unless you want
# backend errors to be reported to Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Configuration/database/listening timings are always logged once per process.
PERF_LOGGING_ENABLED=false
PERF_SLOW_REQUEST_MS=1000

# ─── ImageKit ────────────────────────────────────────────────────────────────
# Used for production admin image uploads. Get these values from the
# ImageKit dashboard under Developer Options / API Keys and URL endpoints.
# Leave blank in local development to use the safe local upload fallback.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/connect-shop

# ─── Email ────────────────────────────────────────────────────────────────────
# Mock delivery is explicit and allowed ONLY in development/test. No bodies/tokens are logged.
# Production: EMAIL_MODE=resend, a customer-domain sender, verified domain and private API key.
EMAIL_MODE=mock
EMAIL_AUTH_ENABLED=true
EMAIL_ORDER_CONFIRMATIONS_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_SENDER_VERIFIED=false
EMAIL_TIMEOUT_MS=5000

# ─── Customer Business Rules (backend is authoritative) ───────────────────────
STORE_NAME=ELECTRO SHOP
STORE_CURRENCY=USD
STORE_LOCALE=en-US
STORE_DEFAULT_COUNTRY=Lebanon
# Fractional rate: 0.11 means 11%. Existing two-decimal monetary rounding is preserved.
STORE_TAX_RATE=0.11
STORE_SHIPPING_DEFAULT=4
# Eligibility uses subtotal BEFORE coupon discount, matching the existing store.
STORE_FREE_SHIPPING_THRESHOLD=150
STORE_SHIPPING_BY_REGION='{"beirut":3,"mount lebanon":4,"north":5,"south":5,"bekaa":5}'

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Session cookie max age in milliseconds (default: 7 days)
COOKIE_MAX_AGE=604800000

# ─── One-Time Super Admin Bootstrap ───────────────────────────────────────────
# Optional. Use only after a fresh database setup when no active super_admin
# exists. Do not leave real bootstrap passwords in production env after use.
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# ADMIN_BOOTSTRAP_NAME=Store Owner
# ADMIN_BOOTSTRAP_PASSWORD=change_me_to_a_temporary_password_at_least_12_chars
