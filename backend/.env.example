# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://elecshop:elecshop_password@localhost:5432/elecshop_db
# Optional query timeout in milliseconds
DB_STATEMENT_TIMEOUT_MS=10000

# ─── Session ──────────────────────────────────────────────────────────────────
# A long, cryptographically random string used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_64_chars_long

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback (dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin that is allowed to send credentialed requests
FRONTEND_URL=http://localhost:3000

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional in local development. If omitted, the backend falls back to
# in-memory rate limiting and disables Redis-backed caching.
# REDIS_URL=redis://localhost:6379

# ─── ImageKit ────────────────────────────────────────────────────────────────
# Used for production admin image uploads. Get these values from the
# ImageKit dashboard under Developer Options / API Keys and URL endpoints.
# Leave blank in local development to use the safe local upload fallback.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/connect-shop

# ─── Email ────────────────────────────────────────────────────────────────────
# Optional. If omitted, email sending is logged as a mock email.
# Do not add a real API key to this example file.
# RESEND_API_KEY=re_placeholder_key

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Session cookie max age in milliseconds (default: 7 days)
COOKIE_MAX_AGE=604800000
