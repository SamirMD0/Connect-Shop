# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_PRETTY=false

# ─── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://elecshop:elecshop_password@localhost:5432/elecshop_db
# Optional query timeout in milliseconds
DB_STATEMENT_TIMEOUT_MS=10000
# Optional one-time startup schema initialization. Prefer explicit migrations in production.
INITIALIZE_DATABASE=false

# ─── Database Backups ─────────────────────────────────────────────────────────
# Used by scripts/backup_db.sh. Leave BACKUP_DIR blank to use
# <project-root>/backups/database, or set an absolute server path.
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7

# ─── Session ──────────────────────────────────────────────────────────────────
# A long, cryptographically random string used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string_at_least_64_chars_long

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5000/api/v1/auth/google/callback (dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin that is allowed to send credentialed requests
FRONTEND_URL=http://localhost:3000

# ─── Redis ────────────────────────────────────────────────────────────────────
# Optional in local development. If omitted, the backend falls back to
# in-memory rate limiting and disables Redis-backed caching.
# REDIS_URL=redis://localhost:6379
# Production/staging should use a paid/higher-capacity managed Redis URL.
REDIS_URL=

# ─── Public Read Rate Limits ──────────────────────────────────────────────────
# Leave blank to use environment-aware defaults.
PUBLIC_READ_WINDOW_MS=900000
PUBLIC_READ_HOMEPAGE_LIMIT=
PUBLIC_READ_PRODUCT_LIST_LIMIT=
PUBLIC_READ_PRODUCT_DETAIL_LIMIT=
PUBLIC_READ_METADATA_LIMIT=
PUBLIC_READ_FALLBACK_LIMIT=
PUBLIC_READ_SSR_LIMIT=

# Server-only shared secret for trusted Next.js SSR public reads.
# Set the same value in backend and frontend. Never prefix this with NEXT_PUBLIC.
INTERNAL_SSR_API_SECRET=

# ─── Sentry Error Tracking ────────────────────────────────────────────────────
# Optional. Leave SENTRY_DSN blank in local development and CI unless you want
# backend errors to be reported to Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
PERF_LOGGING_ENABLED=false
PERF_SLOW_REQUEST_MS=1000

# ─── ImageKit ────────────────────────────────────────────────────────────────
# Used for production admin image uploads. Get these values from the
# ImageKit dashboard under Developer Options / API Keys and URL endpoints.
# Leave blank in local development to use the safe local upload fallback.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/connect-shop

# ─── Email ────────────────────────────────────────────────────────────────────
# Optional. If omitted, email sending is logged as a mock email.
# Do not add a real API key to this example file.
# RESEND_API_KEY=re_placeholder_key
RESEND_API_KEY=

# ─── Cookie ───────────────────────────────────────────────────────────────────
# Session cookie max age in milliseconds (default: 7 days)
COOKIE_MAX_AGE=604800000

# ─── One-Time Super Admin Bootstrap ───────────────────────────────────────────
# Optional. Use only after a fresh database setup when no active super_admin
# exists. Do not leave real bootstrap passwords in production env after use.
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# ADMIN_BOOTSTRAP_NAME=Store Owner
# ADMIN_BOOTSTRAP_PASSWORD=change_me_to_a_temporary_password_at_least_12_chars
