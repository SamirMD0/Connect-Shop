{
  "name": "elecshop-backend",
  "version": "1.0.0",
  "description": "ElecSHOP Express.js backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/admin.role-permissions.test.ts tests/admin.security-monitoring.test.ts tests/auth.session.test.ts tests/homepage.brand-product.validation.test.ts tests/rateLimiter.public-read.test.ts tests/health.rate-limit.test.ts tests/homepage.full-public.test.ts tests/public-cache-policy.test.ts tests/product-query-performance.test.ts",
    "start": "node dist/server.js",
    "db:schema": "psql $DATABASE_URL -f src/db/schema.sql",
    "db:seed": "psql $DATABASE_URL -f src/db/seed.sql",
    "db:migrate": "tsx src/db/migrate.ts",
    "bootstrap:super-admin": "tsx src/db/bootstrapSuperAdmin.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.59.0",
    "@sentry/profiling-node": "^10.59.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.10.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^5.0.0",
    "resend": "^6.12.3",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3"
  }
}
